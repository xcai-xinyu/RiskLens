# Optional root configuration; existing process variables take precedence.
# Demo needs no keys. Use PYTHON_DOTENV_DISABLED=1 for the keyless Quickstart.
# Never commit .env. Leave unused keys/model names empty.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Explicit alternative chat provider; no automatic routing/fallback.
GROQ_API_KEY=
GROQ_MODEL=
# Groq chat is separate from embeddings. Full offline/live research uses OpenAI embeddings.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=1536
# Explicit historical Groq alternative; change all three Chat fields together:
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# Frozen requests retain mode=offline_research: fixed local corpus + external providers.
# Key presence does not authorize spending; see the Step 3 run manifest and budget gate.
# OpenAI Responses has its own versioned S3 profile; Groq 6000/7600/8000 limits do not apply.
# Generic service termination defaults below are SPEC budgets, not Groq quotas.
# Required only for live external search.
TAVILY_API_KEY=
MAX_TOOL_CALLS=12
MAX_LLM_CALLS=10
MAX_REPAIR_ROUNDS=1
RETRIEVAL_LIMIT=12
RUN_TIMEOUT_SECONDS=180
# Optional paths: RISKLENS_DB_PATH, RISKLENS_EVAL_DIR, RISKLENS_API_URL.
