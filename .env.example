# Optional root configuration; existing process variables take precedence.
# Demo needs no keys. Use PYTHON_DOTENV_DISABLED=1 for the keyless Quickstart.
# Never commit .env. Leave unused keys/model names empty.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
# Explicit alternative chat provider; no automatic routing/fallback.
GROQ_API_KEY=
GROQ_MODEL=
# Groq chat is separate from embeddings. Full offline/live research uses OpenAI embeddings.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
# Required only for live external search.
TAVILY_API_KEY=
MAX_TOOL_CALLS=12
MAX_LLM_CALLS=10
MAX_REPAIR_ROUNDS=1
RETRIEVAL_LIMIT=12
RUN_TIMEOUT_SECONDS=180
# Optional paths: RISKLENS_DB_PATH, RISKLENS_EVAL_DIR, RISKLENS_API_URL.
